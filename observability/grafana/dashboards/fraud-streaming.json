{
  "uid": "fraud-streaming",
  "title": "D3 Kafka & Flink",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "fraud"
  ],
  "editable": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consumer lag by partition (scorer)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{consumergroup=\"scorer-champion\"}",
          "legendFormat": "p{{partition}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consumer lag by group",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Messages in per topic (ev/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset[1m]))",
          "legendFormat": "{{topic}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Flink busy time (ms per s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "avg by (task_name) (flink_taskmanager_job_task_busyTimeMsPerSecond)",
          "legendFormat": "{{task_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Flink backpressure (ms per s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "avg by (task_name) (flink_taskmanager_job_task_backPressuredTimeMsPerSecond)",
          "legendFormat": "{{task_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Flink records in / out per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(flink_taskmanager_job_task_numRecordsInPerSecond)",
          "legendFormat": "in",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "expr": "sum(flink_taskmanager_job_task_numRecordsOutPerSecond)",
          "legendFormat": "out",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Checkpoint duration",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "flink_jobmanager_job_lastCheckpointDuration",
          "legendFormat": "last",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Checkpoints completed / failed",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "flink_jobmanager_job_numberOfCompletedCheckpoints",
          "legendFormat": "completed",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        },
        {
          "expr": "flink_jobmanager_job_numberOfFailedCheckpoints",
          "legendFormat": "failed",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redis memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ]
}
